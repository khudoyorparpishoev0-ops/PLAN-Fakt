# Имена переменных совпадают с /opt/app/.env на сервере.
# Секреты в репозиторий не коммитятся — этот файл только образец.

# PostgreSQL (в docker-compose хост = имя сервиса postgres)
DATABASE_URL=postgresql://app:app@localhost:5432/ithona?schema=public

# JWT (понадобится на шаге 2 — авторизация)
JWT_SECRET=change-me

# MinIO / S3 — хранилище вложений заявок (ШАГ 4).
# Если S3_ENDPOINT задан — используется S3/MinIO (бакет создаётся при старте);
# если НЕ задан — файлы пишутся в локальный каталог STORAGE_DIR
# (по умолчанию ./data/attachments) — запасной вариант для сред без MinIO.
S3_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=ithona-attachments
# Необязательные альтернативы: S3_ACCESS_KEY / S3_SECRET_KEY / S3_BUCKET / S3_REGION
# STORAGE_DIR=./data/attachments

# Часовой пояс приложения
TZ=Asia/Dushanbe

# Время жизни токенов (необязательно)
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d

# Порт API (по умолчанию 3000)
PORT=3000

# Пароли тестовых пользователей для seed (в коде не хранятся).
# Если не заданы — seed сгенерирует случайные и напечатает их один раз.
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_DIRECTOR=
SEED_PASSWORD_ACCOUNTANT=
