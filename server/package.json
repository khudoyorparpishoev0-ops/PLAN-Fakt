{
  "name": "it-hona-finance-server",
  "private": true,
  "version": "1.0.0",
  "description": "Бэкенд модуля «Финансы: План-Факт» IT-HONA (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:expense": "tsx check/expense-rule.ts",
    "check:export": "tsx check/export-format.ts",
    "check:planfact": "tsx check/planfact-consistency.ts",
    "check:currency": "tsx check/currency.ts",
    "check:audit": "tsx check/audit-fixes.ts",
    "clean:demo": "tsx scripts/clean-demo.ts",
    "verify:imports": "tsx scripts/verify-image-imports.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1099.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.9",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  }
}
