// Схема данных модуля «Финансы: План-Факт» (ТЗ, раздел 7 + фикстуры фронтенда).
// Деньги хранятся В ДИРАМАХ (1 сомони = 100 дирам) целыми числами (BigInt) —
// поля *_dirams. Курсы валют — точная десятичная арифметика (Decimal), не float.
// Мягкое удаление: deleted_at везде; записи не удаляются физически.

generator client {
  provider      = "prisma-client-js"
  // native — для локальной разработки; debian-openssl-3.0.x — рантайм
  // контейнера (node:20-slim, Debian bookworm, OpenSSL 3).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Роли и пользователи ─────────────────────────────────────────────────────

model Role {
  id        Int       @id @default(autoincrement())
  code      String    @unique // admin | director | accountant
  name      String
  users     User[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("roles")
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  phone              String?
  passwordHash       String?   @map("password_hash")
  // Пароли из seed — временные: при первом входе интерфейс потребует смену
  // (форсирование — на шаге 2 вместе с авторизацией).
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at") // когда пользователь сменил пароль сам
  roleId             Int       @map("role_id")
  role               Role      @relation(fields: [roleId], references: [id])
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  requests       Request[]          @relation("RequestAuthor")
  decisions      Request[]          @relation("RequestDecider")
  stornos        Request[]          @relation("RequestStorno")
  tasksAuthored  Task[]             @relation("TaskAuthor")
  tasksAssigned  Task[]             @relation("TaskAssignee")
  auditLogs      AuditLog[]
  readNotices    NotificationRead[]
  responsibleFor Project[]          @relation("ProjectResponsible")

  @@map("users")
}

// ── Проекты ─────────────────────────────────────────────────────────────────

enum ProjectStatus {
  plan // Плановый
  work // В работе
  done // Завершён
}

model Project {
  id              Int           @id @default(autoincrement())
  name            String        @unique
  groupName       String?       @map("group_name") // группа проектов («Монтажные проекты» и т.п.)
  responsibleName String?       @map("responsible_name") // ответственный как в фикстурах («А. Хакимов»)
  responsibleId   Int?          @map("responsible_id") // FK на users — на будущее
  responsible     User?         @relation("ProjectResponsible", fields: [responsibleId], references: [id])
  status          ProjectStatus @default(plan)
  archived        Boolean       @default(false)
  startDate       DateTime?     @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  operations Operation[]
  plans      Plan[]
  requests   Request[]
  tasks      Task[]
  deals      Deal[]
  stockMoves StockMove[]
  Delivery   Delivery[]

  @@map("projects")
}

// ── Учётные статьи (дерево) ─────────────────────────────────────────────────

enum ArticleType {
  income // Доходы
  expense // Расходы
  asset // Активы
  liability // Обязательства
  equity // Капитал
}

model Article {
  id        Int         @id @default(autoincrement())
  name      String
  type      ArticleType
  parentId  Int?        @map("parent_id")
  parent    Article?    @relation("ArticleTree", fields: [parentId], references: [id])
  children  Article[]   @relation("ArticleTree")
  isSystem  Boolean     @default(false) @map("is_system") // системные нельзя удалять/переименовывать
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")

  operations Operation[]
  plans      Plan[]

  @@unique([name, type, parentId])
  @@map("articles")
}

// ── Справочники ─────────────────────────────────────────────────────────────

model Counterparty {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  note      String? // «Заказчик · ИНН 010203045» и т.п.
  // Карточка клиента (модуль «Клиенты», этап 2)
  kind      String    @default("both") // client | supplier | both
  inn       String?
  phone     String?
  email     String?
  address   String?
  contact   String? // контактное лицо
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  operations Operation[]
  deals      Deal[]
  Delivery   Delivery[]

  @@map("counterparties")
}

model Account {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  note          String? // «Расчётный счёт · остаток …» и т.п.
  // Вид счёта: cash — касса (наличные), bank — расчётный счёт, other.
  // Нужен для карточки «Деньги» (касса и банковские счета показываются раздельно).
  kind          String    @default("other")
  // Входящий остаток на начало учёта, в дирамах: баланс счёта =
  // opening + подтверждённые поступления − подтверждённые выплаты.
  openingDirams BigInt    @default(0) @map("opening_dirams")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  operations Operation[]

  @@map("accounts")
}

model LegalEntity {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("legal_entities")
}

model Good {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  note      String? // «арт. NS-200 · шт» и т.п.
  // Складской учёт (модуль «Склад», этап 2)
  sku       String? // артикул
  unit      String    @default("шт") // единица измерения
  minQty    Decimal   @default(0) @map("min_qty") @db.Decimal(18, 3) // неснижаемый остаток
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  moves          StockMove[]
  positions      DealPosition[]
  delivPositions DeliveryPosition[]

  @@map("goods")
}

// ── Склад: движения товаров (остаток = сумма приходов − расходов) ───────────

model StockMove {
  id         Int       @id @default(autoincrement())
  goodId     Int       @map("good_id")
  good       Good      @relation(fields: [goodId], references: [id])
  type       String // in — приход, out — расход (списание/отгрузка)
  qty        Decimal   @db.Decimal(18, 3)
  date       DateTime  @db.Date
  comment    String?
  projectId  Int?      @map("project_id")
  project    Project?  @relation(fields: [projectId], references: [id])
  dealId     Int?      @map("deal_id") // приход по закупке
  deal       Deal?     @relation(fields: [dealId], references: [id])
  deliveryId Int?      @map("delivery_id") // приход по конкретной поставке
  delivery   Delivery? @relation(fields: [deliveryId], references: [id])
  userId     Int?      @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([goodId, date])
  @@map("stock_moves")
}

// ── Закупки: сделка с позициями (ТЗ, экран «Сделки по закупкам») ────────────

enum DealStatus {
  draft // Черновик
  active // В работе
  done // Закрыта (позиции оприходованы на склад)
  canceled // Отменена
}

model Deal {
  id             Int           @id @default(autoincrement())
  number         String        @unique // «СД-001»
  title          String
  status         DealStatus    @default(draft)
  date           DateTime      @db.Date
  counterpartyId Int?          @map("counterparty_id")
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id])
  projectId      Int?          @map("project_id")
  project        Project?      @relation(fields: [projectId], references: [id])
  comment        String?
  authorId       Int?          @map("author_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  positions  DealPosition[]
  moves      StockMove[]
  payments   Operation[]
  deliveries Delivery[]

  @@index([status])
  @@map("deals")
}

// ── Поставки в рамках сделки закупки ────────────────────────────────────────
// Документ получения товаров и услуг от поставщика. Позиции с товаром из
// справочника приходуются на склад в момент поставки.
model Delivery {
  id             Int           @id @default(autoincrement())
  dealId         Int           @map("deal_id")
  deal           Deal          @relation(fields: [dealId], references: [id])
  date           DateTime      @db.Date
  isPlan         Boolean       @default(false) @map("is_plan") // плановая поставка
  entityName     String?       @map("entity_name") // юрлицо-получатель
  counterpartyId Int?          @map("counterparty_id")
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id])
  projectId      Int?          @map("project_id")
  project        Project?      @relation(fields: [projectId], references: [id])
  comment        String?
  authorId       Int?          @map("author_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  positions DeliveryPosition[]
  moves     StockMove[]

  @@index([dealId])
  @@map("deliveries")
}

model DeliveryPosition {
  id          Int       @id @default(autoincrement())
  deliveryId  Int       @map("delivery_id")
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  name        String
  goodId      Int?      @map("good_id")
  good        Good?     @relation(fields: [goodId], references: [id])
  qty         Decimal   @db.Decimal(18, 3)
  unit        String    @default("шт")
  priceDirams BigInt    @map("price_dirams")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([deliveryId])
  @@map("delivery_positions")
}

model DealPosition {
  id          Int       @id @default(autoincrement())
  dealId      Int       @map("deal_id")
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name        String
  goodId      Int?      @map("good_id")
  good        Good?     @relation(fields: [goodId], references: [id])
  qty         Decimal   @db.Decimal(18, 3)
  unit        String    @default("шт")
  priceDirams BigInt    @map("price_dirams") // цена за единицу, в дирамах
  discountPct Decimal   @default(0) @map("discount_pct") @db.Decimal(5, 2)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("deal_positions")
}

// ── Задачи (модуль «Задачи», этап 2) ────────────────────────────────────────

enum TaskStatus {
  open // Новая
  in_progress // В работе
  done // Выполнена
  canceled // Отменена
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(open)
  priority    String     @default("normal") // low | normal | high
  dueDate     DateTime?  @map("due_date") @db.Date
  doneAt      DateTime?  @map("done_at")
  projectId   Int?       @map("project_id")
  project     Project?   @relation(fields: [projectId], references: [id])
  assigneeId  Int?       @map("assignee_id")
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  authorId    Int        @map("author_id")
  author      User       @relation("TaskAuthor", fields: [authorId], references: [id])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  @@index([status])
  @@index([assigneeId])
  @@map("tasks")
}

model Service {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  note      String? // «услуга · час / смена» и т.п.
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("services")
}

// Настройки системы (ключ–значение). km_rate — ставка компенсации поездок,
// дирам за км (решение заказчика 30.07.2026: по умолчанию 0 = не задана,
// пока не задана — поездки показываются в километрах, а не в деньгах).
model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ── Валюты и курсы ──────────────────────────────────────────────────────────

model Currency {
  code      String    @id // TJS, USD, EUR, RUB, CNY
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  rates      ExchangeRate[]
  operations Operation[]
  requests   Request[]

  @@map("currencies")
}

model ExchangeRate {
  id           Int       @id @default(autoincrement())
  currencyCode String    @map("currency_code")
  currency     Currency  @relation(fields: [currencyCode], references: [code])
  rateDate     DateTime  @map("rate_date") @db.Date
  rate         Decimal   @db.Decimal(18, 6) // курс к TJS, точная десятичная арифметика
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@unique([currencyCode, rateDate])
  @@map("exchange_rates")
}

// ── Операции ────────────────────────────────────────────────────────────────

enum OperationType {
  in // Поступление
  out // Выплата
  move // Перемещение
  accrual // Начисление
}

enum OperationStatus {
  confirmed // Оплата подтверждена
  unconfirmed // Не подтверждена
}

model Operation {
  id              Int             @id @default(autoincrement())
  externalRef     String?         @unique @map("external_ref") // ключ идемпотентности seed («Д-1041», «ops:3»)
  date            DateTime        @db.Date // дата операции
  type            OperationType
  isPlan          Boolean         @default(false) @map("is_plan") // план/факт
  amountDirams    BigInt          @map("amount_dirams") // сумма в валюте операции, в дирамах
  currencyCode    String          @default("TJS") @map("currency_code")
  currency        Currency        @relation(fields: [currencyCode], references: [code])
  rate            Decimal         @default(1) @db.Decimal(18, 6) // курс к TJS на дату курса
  rateDate        DateTime?       @map("rate_date") @db.Date
  amountTjsDirams BigInt          @map("amount_tjs_dirams") // сумма в TJS, в дирамах
  status          OperationStatus @default(confirmed)
  comment         String?
  accountId       Int?            @map("account_id")
  account         Account?        @relation(fields: [accountId], references: [id])
  counterpartyId  Int?            @map("counterparty_id")
  counterparty    Counterparty?   @relation(fields: [counterpartyId], references: [id])
  articleId       Int?            @map("article_id")
  article         Article?        @relation(fields: [articleId], references: [id])
  projectId       Int?            @map("project_id")
  project         Project?        @relation(fields: [projectId], references: [id])
  dealId          Int?            @map("deal_id") // выплата по сделке закупки
  deal            Deal?           @relation(fields: [dealId], references: [id])
  attachments     Attachment[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  @@index([date])
  @@index([projectId])
  @@index([articleId])
  @@index([dealId])
  @@map("operations")
}

// ── Планы (база сравнения «план–факт») ──────────────────────────────────────

model Plan {
  id              Int       @id @default(autoincrement())
  externalRef     String?   @unique @map("external_ref") // ключ идемпотентности seed
  articleId       Int       @map("article_id")
  article         Article   @relation(fields: [articleId], references: [id])
  projectId       Int?      @map("project_id")
  project         Project?  @relation(fields: [projectId], references: [id])
  period          DateTime  @db.Date // первый день месяца
  amountDirams    BigInt    @map("amount_dirams")
  // Отображаемые атрибуты строки отчёта «План-Факт» (экраны «Показатели»/«Расходы»):
  // плановая/фактическая даты, статус («Получен», «Частично оплачено»…),
  // ответственный и причина отклонения — как в колонках прототипа.
  planDate        DateTime? @map("plan_date") @db.Date
  factDate        DateTime? @map("fact_date") @db.Date
  statusLabel     String?   @map("status_label")
  responsibleName String?   @map("responsible_name")
  reason          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([articleId, period])
  @@map("plans")
}

// ── Заявки кабинета бухгалтера ──────────────────────────────────────────────

enum RequestKind {
  payment // Заявка на оплату
  trip // Заявка на поездку
  auto // Расход на авто
}

enum RequestStatus {
  draft // Черновик
  sent // Отправлено
  review // На рассмотрении
  approved // Одобрено
  rejected // Отклонено
}

model Request {
  id               Int           @id @default(autoincrement())
  number           String        @unique // «З-118», «П-054», «А-031»
  kind             RequestKind
  status           RequestStatus @default(draft)
  authorId         Int           @map("author_id")
  author           User          @relation("RequestAuthor", fields: [authorId], references: [id])
  projectId        Int?          @map("project_id")
  project          Project?      @relation(fields: [projectId], references: [id])
  name             String // наименование (оплата) / цель (поездка) / категория (авто)
  amountDirams     BigInt?       @map("amount_dirams") // оплата и авто-расход
  currencyCode     String?       @map("currency_code")
  currency         Currency?     @relation(fields: [currencyCode], references: [code])
  km               Int? // поездка
  category         String? // авто: Бензин / Ремонт / Мойка / Штраф / Запчасти
  counterpartyName String?       @map("counterparty_name") // контрагент поездки (текстом, как в форме)
  requestDate      DateTime      @map("request_date") @db.Date
  decisionById     Int?          @map("decision_by_id")
  decisionBy       User?         @relation("RequestDecider", fields: [decisionById], references: [id])
  decisionAt       DateTime?     @map("decision_at")
  decisionComment  String?       @map("decision_comment")
  // Сторнирование одобренной заявки директором (ТЗ, п. 5): плановая операция
  // гасится обратной записью, заявка остаётся одобренной с отметкой сторно.
  stornoById       Int?          @map("storno_by_id")
  stornoBy         User?         @relation("RequestStorno", fields: [stornoById], references: [id])
  stornoAt         DateTime?     @map("storno_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  attachments Attachment[]

  @@index([status])
  @@map("requests")
}

// Вложение принадлежит либо заявке кабинета, либо операции журнала
// (ТЗ, п. 10: JPG/PNG/PDF до 10 МБ в объектном хранилище).
model Attachment {
  id           Int        @id @default(autoincrement())
  requestId    Int?       @map("request_id")
  request      Request?   @relation(fields: [requestId], references: [id])
  operationId  Int?       @map("operation_id")
  operation    Operation? @relation(fields: [operationId], references: [id])
  kind         String // doc | photo | receipt
  fileName     String     @map("file_name")
  storageKey   String?    @map("storage_key") // ключ в MinIO (S3)
  mime         String?
  size         Int?
  uploadedById Int?       @map("uploaded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@unique([requestId, fileName])
  @@unique([operationId, fileName])
  @@index([operationId])
  @@map("attachments")
}

// ── Аудит-лог ───────────────────────────────────────────────────────────────

model AuditLog {
  id        Int       @id @default(autoincrement())
  userId    Int?      @map("user_id")
  user      User?     @relation(fields: [userId], references: [id])
  entity    String // имя сущности («operation», «request», …)
  entityId  String    @map("entity_id")
  action    String // create | update | delete | status_change | …
  oldValue  Json?     @map("old_value")
  newValue  Json?     @map("new_value")
  ip        String?
  device    String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([entity, entityId])
  @@map("audit_logs")
}

// ── Выгрузки по расписанию (ТЗ, п. 11, этап 2) ──────────────────────────────

model ScheduledExport {
  id        Int       @id @default(autoincrement())
  kind      String // report | projects | operations
  frequency String // daily | weekly | monthly
  hourUtc   Int       @default(6) @map("hour_utc") // час запуска по UTC
  // Кому отправлять письмо; пусто — файл только копится в панели
  email     String?
  enabled   Boolean   @default(true)
  lastRunAt DateTime? @map("last_run_at")
  nextRunAt DateTime  @map("next_run_at")
  lastError String?   @map("last_error")
  authorId  Int?      @map("author_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  files ExportFile[]

  @@index([enabled, nextRunAt])
  @@map("scheduled_exports")
}

model ExportFile {
  id         Int              @id @default(autoincrement())
  scheduleId Int?             @map("schedule_id")
  schedule   ScheduledExport? @relation(fields: [scheduleId], references: [id])
  kind       String
  fileName   String           @map("file_name")
  storageKey String           @map("storage_key")
  size       Int?
  // Ушло ли письмо: sent | skipped | error
  mailStatus String           @default("skipped") @map("mail_status")
  createdAt  DateTime         @default(now()) @map("created_at")
  deletedAt  DateTime?        @map("deleted_at")

  @@index([createdAt])
  @@map("export_files")
}

// ── Прочитанные уведомления ─────────────────────────────────────────────────
// Уведомления не хранятся строками: они считаются из данных (заявки, остатки,
// задачи, просроченные планы) и опознаются устойчивым ключом «req:12».
// Хранить нужно только то, чего из данных не вывести, — прочёл ли КОНКРЕТНЫЙ
// человек конкретное событие. Правило из дизайн-пакета: «прочитано» —
// состояние пользователя, а не системы: директор прочитал, у бухгалтера
// уведомление осталось непрочитанным.
model NotificationRead {
  id     Int      @id @default(autoincrement())
  userId Int      @map("user_id")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String // «req:12», «stock:3», «task:7» — ключ события
  readAt DateTime @default(now()) @map("read_at")

  @@unique([userId, key])
  @@index([userId])
  @@map("notification_reads")
}
